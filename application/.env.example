# =============================================================================
# .env.example — Environment Variable Template
# Copy this file to .env for local development. NEVER commit .env.
# =============================================================================

# ----- Flask Application -----
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-long-random-secret-key

# ----- Database -----
# Local development (SQLite for quick start)
DATABASE_URL=sqlite:///tasks.db

# PostgreSQL (for staging/production)
# DATABASE_URL=postgresql://taskuser:yourpassword@localhost:5432/taskdb

# ----- AWS Metadata (injected automatically on EC2) -----
# These are populated automatically via the IMDSv2 endpoint on EC2.
# Leave empty for local development.
AWS_REGION=eu-west-3
INSTANCE_ID=
AVAILABILITY_ZONE=

# ----- Application Settings -----
APP_VERSION=1.0.0
APP_NAME=task-manager
LOG_LEVEL=INFO

# ----- Gunicorn (production) -----
GUNICORN_WORKERS=2
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_TIMEOUT=120
